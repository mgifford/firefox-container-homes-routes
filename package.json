{
  "name": "container-homes-routes",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Development fork of Container Homes: set a home URL and up to 9 app slots per Firefox container. Project and account routing is in progress.",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.mjs",
    "lint": "web-ext lint",
    "start": "web-ext run",
    "build": "web-ext build",
    "sign": "web-ext sign --channel unlisted"
  },
  "webExt": {
    "ignoreFiles": [
      "test"
    ]
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "selenium-webdriver": "4.50.0",
    "web-ext": "^10.6.0"
  }
}
